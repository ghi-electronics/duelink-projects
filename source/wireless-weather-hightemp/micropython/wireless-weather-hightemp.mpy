# This sample runs on QT-PY 2040 adafruit, and may need i2c pullup module
# In this sample:
# Get HighTemp()
# You need to install the script from the link below on the device:
# https://github.com/ghi-electronics/duelink-projects/blob/main/source/wireless-weather-hightemp/standalone/wireless-weather-hightemp.txt



import time
import duelink 

from duelink import transport

sclPIN = machine.Pin(23)
sdaPIN = machine.Pin(22)
 
i2c = transport.I2CTransportController(sda=sdaPIN, scl=sclPIN)
due = duelink.DUELinkController(i2c)

# methods & variable

def IsWiFiConnected():
    # Pin 5 goes low when WiFi is connected
    ret = due.Engine.ExecuteCommand("dread(5,1)")
    return int(ret) == 0

def HighTemp():
    ret = due.Engine.ExecuteCommand("HighTemp()")
    return ret

# HighTemp() accesses the web and parses JSON, which could take up to 6 seconds
due.ReadTimeout = 6

while True:
    if not IsWiFiConnected():
        print("Wait for WiFi connection...")
        time.sleep(1)
        continue

    print("High Temp:", HighTemp())



