{
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "fsmnt",
        "description": "Mount file system on SPI media. type: 1=SD card, 2=USB. cs=chip select pin. baud in kHz. max_handle is max open files. Returns 0 if success.",
        "parameters": {
          "type": "object",
          "properties": {
            "type": {
              "type": "integer",
              "enum": [ 0, 1, 2 ]
            },
            "cs": { "type": "integer" },
            "baud": { "type": "integer" },
            "max_handle": { "type": "integer" }
          },
          "required": [ "type", "cs", "baud", "max_handle" ]
        }
      }
    },

    {
      "type": "function",
