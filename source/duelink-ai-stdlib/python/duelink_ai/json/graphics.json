{
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "gfxcfg",
        "description": "Configure graphics device. type: 0=None,1=I2C display,2=SPI display,3=NeoPixel,4=LED matrix scanner,5=LED matrix list,6=ePaper. cfg depends on device type. width and height define resolution. mode=0 direct, >0 buffered.",
        "parameters": {
          "type": "object",
          "properties": {
            "type": {
              "type": "integer",
              "enum": [ 0, 1, 2, 3, 4, 5, 6 ]
            },
            "cfg": {
              "type": "array",
              "items": {
                "type": [ "number", "string" ]
              },
              "description": "Configuration array depending on device type"
            },
            "width": {
              "type": "integer"
            },
            "height": {
              "type": "integer"
            },
            "mode": {
              "type": "integer",
              "description": "0=direct, >0 buffered"
            }
          },
          "required": [ "type", "width", "height", "mode" ]
        }
      }
    },

